APP_HOST=0.0.0.0
APP_PORT=8080
MONGODB_URI=mongodb://activity:activity@localhost:27017/activity_tracker?authSource=admin
MONGODB_DATABASE=activity_tracker
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RUST_LOG=activity_tracker=info,tower_http=info
JSON_LOGS=false

# Local development values; change tokens/passwords for a shared deployment.
CHAT_INTERNAL_TOKEN=activity-chat-local-development
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen3:8b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LOOKUP_MODEL=openai/gpt-oss-20b
GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b
GROQ_RELATIONSHIPS_MODEL=openai/gpt-oss-120b
GROQ_VISUALIZATION_MODEL=openai/gpt-oss-120b
LLM_LOOKUP_PROVIDER=local
LLM_ANALYSIS_PROVIDER=groq
LLM_RELATIONSHIPS_PROVIDER=groq
LLM_VISUALIZATION_PROVIDER=groq
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=activity-graph-local
NEO4J_DATABASE=neo4j
